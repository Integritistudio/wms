NODE_ENV=development
SERVER_PORT=8714
RUN_MIGRATIONS=true

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=failed_ms

ENCRYPTION_KEY=change-me-to-a-long-random-secret
ADMIN_API_SECRET=change-me-admin-secret

# Callback into wms-app-backend for retry/reassign execution
WMS_LINKER_BASE_URL=http://127.0.0.1:3000
FAILED_MS_CALLBACK_SECRET=change-me-callback-secret

PGBOSS_SCHEMA=pgboss
PGBOSS_RETRY_LIMIT=5
PGBOSS_RETRY_DELAY_SECONDS=30
PGBOSS_EXPIRE_IN_SECONDS=900
PGBOSS_TEAM_CONCURRENCY=5

AUTO_RETRY_POLL_SECONDS=15
AUTO_RETRY_BATCH_SIZE=25
ALERT_POLL_SECONDS=60
STALE_SWEEP_HOURS=168
STALE_SWEEP_POLL_MINUTES=60

DEFAULT_MAX_ATTEMPTS=5
DEFAULT_BASE_DELAY_SECONDS=30
DEFAULT_MAX_DELAY_SECONDS=900
DEFAULT_BACKOFF_MULTIPLIER=2
