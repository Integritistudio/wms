NODE_ENV=development
SERVER_PORT=8718
RUN_MIGRATIONS=true

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=root
DB_NAME=sftp_ms

ENCRYPTION_KEY=change-me-to-a-long-random-secret-32chars
ADMIN_API_SECRET=change-me-admin-secret

# Callback when inbound EDI files are polled
WMS_LINKER_BASE_URL=http://127.0.0.1:3000
SFTP_MS_CALLBACK_SECRET=change-me-callback-secret

PGBOSS_SCHEMA=pgboss
PGBOSS_RETRY_LIMIT=5
PGBOSS_RETRY_DELAY_SECONDS=30
PGBOSS_EXPIRE_IN_SECONDS=1800
PGBOSS_TEAM_CONCURRENCY=3

TRANSFER_POLL_SECONDS=5
TRANSFER_BATCH_SIZE=20
INBOUND_POLL_SECONDS=60
ALLOW_PRIVATE_HOSTS=true
MAX_FILE_BYTES=5242880
