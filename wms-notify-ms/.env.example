NODE_ENV=development
SERVER_PORT=8720
RUN_MIGRATIONS=true

# Docker Compose local-db: DB_HOST=postgres DB_PORT=5432 DB_PUBLISH_PORT=8721
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=root
DB_NAME=notify_ms
DB_PUBLISH_PORT=8721

ADMIN_API_SECRET=change-me-admin-secret

# Optional Web Push (VAPID). Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@example.com

# Optional FCM legacy HTTP server key (device platform=fcm|android|ios)
FCM_SERVER_KEY=

# Optional generic webhook for push (POST JSON {token,title,body,data,platform})
PUSH_WEBHOOK_URL=

PGBOSS_SCHEMA=pgboss
PGBOSS_RETRY_LIMIT=5
PGBOSS_RETRY_DELAY_SECONDS=30
PGBOSS_EXPIRE_IN_SECONDS=1800
PGBOSS_TEAM_CONCURRENCY=5

PUSH_POLL_SECONDS=5
PUSH_BATCH_SIZE=50
READ_RETENTION_DAYS=7
NOTIFICATION_TTL_DAYS=90
