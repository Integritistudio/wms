NODE_ENV=development
SERVER_PORT=8181
RUN_MIGRATIONS=true

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=shipoo_ms

ENCRYPTION_KEY=change-me-to-a-long-random-secret

ADMIN_API_SECRET=change-me-admin-secret

SHIPPO_PLATFORM_API_TOKEN=shippo_test_your_token
SHIPOO_API_KEY=
SHIPPO_API_BASE_URL=https://api.goshippo.com
SHIPPO_WEBHOOK_PUBLIC_URL=https://your-domain.com/v1/webhooks/shippo/track-updated
SHIPPO_INBOUND_WEBHOOK_SECRET=

TRACKING_PROVIDER=shippo

PGBOSS_SCHEMA=pgboss
PGBOSS_RETRY_LIMIT=5
PGBOSS_RETRY_DELAY_SECONDS=30
PGBOSS_EXPIRE_IN_SECONDS=900
PGBOSS_TEAM_CONCURRENCY=5

RECONCILE_CRON_MINUTES=15
RECONCILE_STALE_MINUTES=60
RECONCILE_BATCH_SIZE=50

OUTBOUND_WEBHOOK_TIMEOUT_MS=10000
OUTBOUND_WEBHOOK_REQUIRE_HTTPS=false
# Set true only for local e2e tests that deliver to 127.0.0.1
OUTBOUND_WEBHOOK_ALLOW_PRIVATE=false

OBSERVE_ENABLED=false
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=
OBSERVE_SERVICE_ID=wms-tracking-ms
