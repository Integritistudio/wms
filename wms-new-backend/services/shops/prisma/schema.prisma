generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model OutboxEvent {
  id          String    @id @default(uuid()) @db.Uuid
  exchange    String
  routingKey  String    @map("routing_key")
  payload     Json
  status      String    @default("pending")
  attempts    Int       @default(0)
  lastError   String?   @map("last_error")
  createdAt   DateTime  @default(now()) @map("created_at")
  publishedAt DateTime? @map("published_at")

  @@index([status, createdAt])
  @@map("outbox_events")
}

model Shop {
  id                 String   @id @default(uuid()) @db.Uuid
  domain             String   @unique
  companyId          String   @map("company_id") @db.Uuid
  warehouseId        String?  @map("warehouse_id") @db.Uuid
  /// Plug-and-play ecommerce provider key
  ecommerceProvider  String   @default("shopify") @map("ecommerce_provider")
  enabled            Boolean  @default(true)
  mappingKey         String   @default("generic") @map("mapping_key")
  accessTokenEnc     String?  @map("access_token_enc")
  scopes             String?
  installedAt        DateTime? @map("installed_at")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@index([companyId])
  @@index([ecommerceProvider])
  @@map("shops")
}
