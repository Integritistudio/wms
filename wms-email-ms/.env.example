NODE_ENV=development
SERVER_PORT=8716
RUN_MIGRATIONS=true

# Shared Postgres (ms-wms host). Create DB: CREATE DATABASE email_ms;
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=root
DB_NAME=email_ms

ENCRYPTION_KEY=change-me-to-a-long-random-secret-32chars
ADMIN_API_SECRET=change-me-admin-secret

# Optional platform default SMTP (tenants can override with encrypted credentials)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_SECURE=false

PGBOSS_SCHEMA=pgboss
PGBOSS_RETRY_LIMIT=8
PGBOSS_RETRY_DELAY_SECONDS=30
PGBOSS_EXPIRE_IN_SECONDS=1800
PGBOSS_TEAM_CONCURRENCY=5

MAIL_POLL_SECONDS=5
MAIL_BATCH_SIZE=25
DEFAULT_DAILY_QUOTA=2000
MAX_RECIPIENTS_PER_MESSAGE=50
ALLOW_HTML=true
